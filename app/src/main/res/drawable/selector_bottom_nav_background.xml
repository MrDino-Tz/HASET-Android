<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Active State: Top Line Indicator -->
    <item android:state_checked="true">
        <layer-list>
            <item android:gravity="top|center_horizontal"> <!-- Centered Dash -->
                <shape android:shape="rectangle">
                    <size android:height="4dp" android:width="32dp" /> <!-- Dash Dimensions -->
                    <corners android:bottomLeftRadius="2dp" android:bottomRightRadius="2dp" />
                    <solid android:color="@color/green_primary" />
                </shape>
            </item>
            <!-- Removed background tint to match the clean white look of the reference image -->
        </layer-list>
    </item>
    
    <!-- Inactive State -->
    <item android:drawable="@android:color/transparent" />
</selector>
