<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_gray">
    <!-- The mask layer defines the bounds of the ripple. 
         We use a radius of 12dp to ensure the corners are clearly visible and rounded. -->
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    
    <!-- Optional: Add a transparent background layer to ensure the view takes up space correctly in interactions -->
    <item android:drawable="@android:color/transparent" />
</ripple>
