<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@drawable/bg_rounded_bottom_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvSheetTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/create_new_banner"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/green_primary"
            android:layout_marginBottom="16dp" />

        <!-- Step 1: Banner Type Selection -->
        <LinearLayout
            android:id="@+id/layoutBannerTypeSelection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/choose_banner_type"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp"
                android:layout_marginBottom="16dp" />

            <RadioGroup
                android:id="@+id/rgBannerType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbDetailedBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/detailed_banner"
                    android:textSize="15sp"
                    android:padding="12dp"
                    android:checked="true"
                    android:background="@drawable/bg_radio_option"
                    android:layout_marginBottom="8dp" />

                <RadioButton
                    android:id="@+id/rbImageBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/image_banner"
                    android:textSize="15sp"
                    android:padding="12dp"
                    android:background="@drawable/bg_radio_option" />

            </RadioGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNextStep"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/next"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/white_primary"
                android:fontFamily="@font/poppins_medium"
                android:stateListAnimator="@animator/press_scale"
                android:layout_marginTop="20dp"
                app:cornerRadius="12dp"
                android:backgroundTint="@color/green_primary" />

        </LinearLayout>

        <!-- Step 2: Detailed Banner Form -->
        <LinearLayout
            android:id="@+id/layoutDetailedForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/detailed_banner_info"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="14sp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_title_line1"
                style="@style/EditTextStyle"
                app:startIconDrawable="@drawable/ic_edit"
                app:startIconTint="@color/text_secondary"
                app:hintTextColor="@color/text_secondary"
                app:boxStrokeColor="@color/green_primary"
                app:boxStrokeWidth="1dp"
                app:boxCornerRadiusTopStart="20dp"
                app:boxCornerRadiusTopEnd="20dp"
                app:boxCornerRadiusBottomStart="20dp"
                app:boxCornerRadiusBottomEnd="20dp"
                android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTitle1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_title_line2"
                style="@style/EditTextStyle"
                app:startIconDrawable="@drawable/ic_edit"
                app:startIconTint="@color/text_secondary"
                app:hintTextColor="@color/text_secondary"
                app:boxStrokeColor="@color/green_primary"
                app:boxStrokeWidth="1dp"
                app:boxCornerRadiusTopStart="20dp"
                app:boxCornerRadiusTopEnd="20dp"
                app:boxCornerRadiusBottomStart="20dp"
                app:boxCornerRadiusBottomEnd="20dp"
                android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTitle2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_badge_text"
                style="@style/EditTextStyle"
                app:startIconDrawable="@drawable/ic_edit"
                app:startIconTint="@color/text_secondary"
                app:hintTextColor="@color/text_secondary"
                app:boxStrokeColor="@color/green_primary"
                app:boxStrokeWidth="1dp"
                app:boxCornerRadiusTopStart="20dp"
                app:boxCornerRadiusTopEnd="20dp"
                app:boxCornerRadiusBottomStart="20dp"
                app:boxCornerRadiusBottomEnd="20dp"
                android:layout_marginBottom="12dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBadge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_button_text"
                style="@style/EditTextStyle"
                app:startIconDrawable="@drawable/ic_edit"
                app:startIconTint="@color/text_secondary"
                app:hintTextColor="@color/text_secondary"
                app:boxStrokeColor="@color/green_primary"
                app:boxStrokeWidth="1dp"
                app:boxCornerRadiusTopStart="20dp"
                app:boxCornerRadiusTopEnd="20dp"
                app:boxCornerRadiusBottomStart="20dp"
                app:boxCornerRadiusBottomEnd="20dp"
                android:layout_marginBottom="16dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/banner_action_type"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/rgDetailedActionType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <RadioButton
                    android:id="@+id/rbPharmacyDetailed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/pharmacy"
                    android:checked="true"
                    android:layout_marginEnd="4dp" />

                <RadioButton
                    android:id="@+id/rbChatDetailed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/chat"
                    android:layout_marginEnd="4dp" />

                <RadioButton
                    android:id="@+id/rbDoctorsDetailed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/doctors"
                    android:layout_marginEnd="4dp" />

                <RadioButton
                    android:id="@+id/rbArticleDetailed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/articles" />

            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/upload_banner_image"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/image_requirements"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectImageDetailed"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/select_image"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/poppins_medium"
                android:stateListAnimator="@animator/press_scale"
                app:cornerRadius="20dp"
                app:backgroundTint="@color/grey_light"
                app:strokeColor="@color/grey_dark"
                app:strokeWidth="1dp" />

            <ImageView
                android:id="@+id/ivPreviewDetailed"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="12dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:background="@color/grey_light" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBackDetailed"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="@string/back"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/poppins_medium"
                    android:stateListAnimator="@animator/press_scale"
                    android:layout_marginEnd="8dp"
                    app:cornerRadius="20dp"
                    app:backgroundTint="@color/grey_light"
                    app:strokeColor="@color/grey_dark"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubmitDetailed"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="@string/upload_banner"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/white_primary"
                    android:fontFamily="@font/poppins_medium"
                    android:stateListAnimator="@animator/press_scale"
                    android:layout_marginStart="8dp"
                    app:cornerRadius="20dp"
                    android:backgroundTint="@color/green_primary" />

            </LinearLayout>

        </LinearLayout>

        <!-- Step 2: Image Banner Form -->
        <LinearLayout
            android:id="@+id/layoutImageForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/image_banner_info"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="14sp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/upload_banner_image"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/image_requirements"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectImage"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:text="@string/tap_to_select_image"
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="@font/poppins_medium"
                android:stateListAnimator="@animator/press_scale"
                android:gravity="center"
                app:cornerRadius="16dp"
                app:backgroundTint="@color/grey_light"
                app:strokeColor="@color/grey_dark"
                app:strokeWidth="2dp" />

            <ImageView
                android:id="@+id/ivPreview"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="12dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:background="@color/grey_light"
                android:elevation="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBackImage"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="@string/back"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/poppins_medium"
                    android:stateListAnimator="@animator/press_scale"
                    android:layout_marginEnd="8dp"
                    app:cornerRadius="20dp"
                    app:backgroundTint="@color/grey_light"
                    app:strokeColor="@color/grey_dark"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubmitImage"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="@string/upload_banner"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/white_primary"
                    android:fontFamily="@font/poppins_medium"
                    android:stateListAnimator="@animator/press_scale"
                    android:layout_marginStart="8dp"
                    app:cornerRadius="20dp"
                    android:backgroundTint="@color/green_primary" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
