<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="250dp"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="?attr/colorCardBackground">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- Doctor Image -->
        <FrameLayout
            android:id="@+id/layoutDoctorImage"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_alignParentStart="true">

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerDoctorImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:shimmer_auto_start="true"
                app:shimmer_base_alpha="0.8"
                app:shimmer_highlight_alpha="1.0">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/shimmer_circle" />

            </com.facebook.shimmer.ShimmerFrameLayout>

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/ivDoctorImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@android:drawable/ic_menu_myplaces"
                app:civ_border_width="1.5dp"
                app:civ_border_color="@color/green_light" />

            <ImageView
                android:id="@+id/ivVerified"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="2dp"
                android:src="@drawable/verified"
                app:tint="@color/green_primary"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Favorite -->
        <ImageView
            android:id="@+id/ivFavorite"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:src="@android:drawable/btn_star_big_off"
            android:padding="6dp"
            app:tint="@color/text_hint"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <!-- Info -->
        <LinearLayout
            android:id="@+id/layoutDoctorInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/layoutDoctorImage"
            android:layout_toStartOf="@id/ivFavorite"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <!-- Name + Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvDoctorName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Dr. Sarah Smith"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Online"
                    android:textSize="11sp"
                    android:textColor="@color/green_primary"
                    android:background="@drawable/bg_status_online"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp" />
            </LinearLayout>

            <!-- Specialty -->
            <TextView
                android:id="@+id/tvSpecialty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cardiologist"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />

            <!-- Available Time -->
            <TextView
                android:id="@+id/tvAvailableTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" • 10:00 - 20:00"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp" />

            <!-- Fee -->
            <TextView
                android:id="@+id/tvConsultationFee"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Consultation: 0 TZS"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/green_primary"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Book Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBook"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_below="@id/layoutDoctorInfo"
            android:layout_marginTop="10dp"
            android:text="Book Appointment"
            android:textAllCaps="false"
            android:textSize="13sp"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/green_primary" />

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>
