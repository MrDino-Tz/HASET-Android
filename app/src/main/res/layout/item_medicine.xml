<?xml version="1.0" encoding="utf-8"?>
<!--
    Medicine table row — aligns with the column header in bottom_sheet_prescription_details.xml
    Columns: MEDICATION (weight 2) | DOSAGE (weight 1) | FREQUENCY (weight 1.5) | DAYS (weight 1)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp"
    android:paddingVertical="7dp"
    android:background="@android:color/transparent">

    <TextView
        android:id="@+id/tvMedicineName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:fontFamily="@font/poppins_medium"
        android:textColor="@color/text_primary"
        android:textSize="11sp"
        tools:text="Amoxicillin" />

    <TextView
        android:id="@+id/tvDosage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="@font/poppins_regular"
        android:textColor="@color/text_primary"
        android:textSize="11sp"
        tools:text="500 mg" />

    <TextView
        android:id="@+id/tvFrequency"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.5"
        android:fontFamily="@font/poppins_regular"
        android:textColor="@color/text_primary"
        android:textSize="11sp"
        tools:text="3× daily" />

    <TextView
        android:id="@+id/tvDuration"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="@font/poppins_regular"
        android:textColor="@color/text_primary"
        android:textSize="11sp"
        tools:text="7 days" />

</LinearLayout>
