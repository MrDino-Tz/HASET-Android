<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/rounded_edittext_background"
    android:elevation="4dp"
    android:outlineAmbientShadowColor="@color/chat_shadow_color"
    android:outlineSpotShadowColor="@color/chat_shadow_color"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Close/Cancel Button -->
    <ImageView
        android:id="@+id/btnClose"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:src="@drawable/ic_close"
        android:background="@drawable/bg_search_circle"
        android:foreground="@drawable/ripple_effect_circular"
        android:padding="9dp"
        android:clickable="true"
        android:focusable="true"
        android:stateListAnimator="@animator/press_scale"
        app:tint="@color/text_secondary" />

    <!-- Recording Duration -->
    <TextView
        android:id="@+id/tvRecordingDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="48dp"
        android:text="00:00"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="@font/poppins_medium"
        android:gravity="center" />

    <!-- Voice Wave View -->
    <com.haset.hasetapp.views.VoiceWaveView
        android:id="@+id/voiceWaveView"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="6dp"
        android:background="@android:color/transparent" />

    <!-- Recording Status Icon -->
    <ImageView
        android:id="@+id/ivRecordingIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_mic"
        app:tint="@color/text_secondary" />

    <!-- Record/Stop Button -->
    <ImageView
        android:id="@+id/btnRecord"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:src="@drawable/ic_mic"
        android:background="@drawable/bg_search_circle"
        android:foreground="@drawable/ripple_effect_circular"
        android:padding="9dp"
        android:clickable="true"
        android:focusable="true"
        android:stateListAnimator="@animator/press_scale"
        app:tint="@color/green_primary" />

</LinearLayout>
