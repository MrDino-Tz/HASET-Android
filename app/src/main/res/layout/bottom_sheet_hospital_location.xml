<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/dialog_background">

    <!-- Header Row: Handle Bar centered, Close Button at end -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:background="@android:color/transparent" />

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:background="@drawable/bottom_sheet_handle" />

        <View
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:background="@android:color/transparent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseHospitalLocation"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:background="@android:color/transparent"
            app:icon="@drawable/ic_close"
            app:iconGravity="textStart"
            app:iconSize="24dp"
            app:strokeWidth="0dp"
            style="@style/Widget.Material3.Button.TextButton" />
    </LinearLayout>

    <!-- Location Icon -->
<!--    <ImageView-->
<!--        android:layout_width="48dp"-->
<!--        android:layout_height="48dp"-->
<!--        android:layout_gravity="center"-->
<!--        android:src="@drawable/ic_hospital_24"-->
<!--        app:tint="@color/green_primary"-->
<!--        android:layout_marginBottom="12dp"-->
<!--        android:contentDescription="@string/hospital_location_title" />-->

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/hospital_location_title"
        android:textColor="?attr/colorOnSurface"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- Map -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_rounded_map"
        android:clipToOutline="true">

        <WebView
            android:id="@+id/webViewHospitalMap"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_rounded_map"
            android:clipToOutline="true" />

        <ProgressBar
            android:id="@+id/progressBarMapLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- Open in Google Maps Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenInMaps"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/open_in_google_maps"
        android:textSize="14sp"
        android:fontFamily="@font/poppins_medium"
        android:textColor="@color/white_primary"
        app:backgroundTint="@color/green_primary"
        app:cornerRadius="12dp"
        android:layout_marginBottom="12dp" />

</LinearLayout>
