<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_background"
    android:padding="24dp">

    <!-- Icon Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/ivDialogIcon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_warning"
            android:background="@drawable/circle_background_warning"
            android:padding="16dp"
            android:scaleType="centerInside"
            app:tint="@color/warning_color" />

    </LinearLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:fontFamily="@font/poppins_medium"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <!-- Message -->
    <TextView
        android:id="@+id/tvDialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_message_goes_here_this_can_be_a_l"
        android:textSize="16sp"
        android:textColor="@color/text_secondary"
        android:fontFamily="@font/poppins_medium"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:layout_marginBottom="24dp" />

    <!-- Buttons Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNegative"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:stateListAnimator="@animator/press_scale"
            android:text="@string/cancel_btn"
            android:textColor="@color/text_secondary"
            android:fontFamily="@font/poppins_medium"
            app:backgroundTint="@android:color/transparent"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPositive"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:stateListAnimator="@animator/press_scale"
            android:text="@string/confirm"
            android:textColor="@color/white"
            android:fontFamily="@font/poppins_medium"
            app:backgroundTint="@color/green_primary"
            app:cornerRadius="8dp" />

    </LinearLayout>

</LinearLayout>
