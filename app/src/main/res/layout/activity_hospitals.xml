<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/background_primary"
    android:fitsSystemWindows="true"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <ImageView
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_search_circle"
        android:foreground="@drawable/ripple_effect_circular"
        android:clickable="true"
        android:focusable="true"
        android:stateListAnimator="@animator/press_scale"
        android:padding="10dp"
        android:src="@drawable/ic_angle_left_solid"
        app:tint="@color/green_primary"
        android:elevation="24dp"
        android:outlineAmbientShadowColor="@color/chat_shadow_color"
        android:outlineSpotShadowColor="@color/chat_shadow_color" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:fontFamily="@font/poppins_medium"
            android:text="Find Hospital"
            android:textColor="@color/green_primary"
            android:textSize="20sp"
            android:layout_marginStart="16dp" />
    </LinearLayout>

    <include
        android:id="@+id/layoutEmptyState"
        layout="@layout/layout_empty_state_simple"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHospitals"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</LinearLayout>
