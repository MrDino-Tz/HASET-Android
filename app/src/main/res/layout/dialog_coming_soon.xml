<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="@drawable/dialog_background">

    <ImageView
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:src="@drawable/coming_soon12"
        android:layout_marginBottom="16dp"/>

<!--    <TextView-->
<!--        android:id="@+id/tvTitle"-->
<!--        android:layout_width="wrap_content"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:text="Coming Soon!"-->
<!--        android:textSize="22sp"-->
<!--        android:textStyle="bold"-->
<!--        android:textColor="?attr/colorPrimaryText"-->
<!--        android:fontFamily="@font/poppins_medium"-->
<!--        android:layout_marginBottom="8dp"/>-->

    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="We're working hard to bring this feature to you soon. Stay tuned for exciting updates!"
        android:textSize="14sp"
        android:textColor="?attr/colorSecondaryText"
        android:fontFamily="@font/poppins_medium"
        android:gravity="center"
        android:layout_marginBottom="24dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOk"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="Sounds Good"
        android:textAllCaps="false"
        android:textSize="16sp"
        app:cornerRadius="12dp"
        android:stateListAnimator="@animator/press_scale"
        android:backgroundTint="@color/green_primary"
        android:textColor="@color/white"
        android:fontFamily="@font/poppins_medium" />

</LinearLayout>
