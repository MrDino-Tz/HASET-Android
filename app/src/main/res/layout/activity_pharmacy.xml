<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Search Bar Section (Fixed at top) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:background="@color/background_primary"
            android:elevation="4dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Back Button -->
                    <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_search_circle"
            android:foreground="@drawable/ripple_effect_rounded"            android:clickable="true"
            android:focusable="true"
            android:stateListAnimator="@animator/press_scale"
            android:padding="10dp"
            android:src="@drawable/ic_angle_left_solid"
            app:tint="@color/green_primary"
            android:elevation="24dp"
            android:outlineAmbientShadowColor="@color/chat_shadow_color"
            android:outlineSpotShadowColor="@color/chat_shadow_color" />

            <!-- Search Input -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/grey_light">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_search"
                        app:tint="@color/text_secondary"
                        android:layout_marginEnd="8dp" />

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPharmacySearch"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/search_medicine"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:inputType="text"
                        android:maxLines="1"
                        android:background="@android:color/transparent"
                        android:fontFamily="@font/poppins_regular" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Camera Icon -->
            <ImageView
                android:id="@+id/btnCameraSearch"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_camera_alt"
                android:background="@drawable/ripple_effect_rounded"
                android:clickable="true"
                android:focusable="true"
                app:tint="@color/green_primary"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp" />

            <!-- Cart Icon with Badge -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp">

                <ImageView
                    android:id="@+id/btnCart"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_cart"
                    android:background="@drawable/ripple_effect_rounded"
                    android:clickable="true"
                    android:focusable="true"
                    app:tint="@color/green_primary" />

                <TextView
                    android:id="@+id/tvCartBadge"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/notification_badge_background"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_medium"
                    android:visibility="gone" />

            </FrameLayout>

        </LinearLayout>

        <!-- Fragment Container -->
        <FrameLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- Bottom Navigation -->


        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavPharmacy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/background_primary"
            app:menu="@menu/bottom_nav_pharmacy"
            app:itemIconTint="@color/bottom_nav_pharmacy_color"
            app:itemTextColor="@color/bottom_nav_pharmacy_color"
            app:labelVisibilityMode="labeled" />



</androidx.coordinatorlayout.widget.CoordinatorLayout>
