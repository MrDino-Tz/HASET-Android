<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/background_primary"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Top Header (Fixed at the top) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:elevation="2dp"
        android:clipChildren="false"
        android:clipToPadding="false">

                <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_search_circle"
            android:foreground="@drawable/ripple_effect_rounded"
            android:clickable="true"
            android:focusable="true"
            android:stateListAnimator="@animator/press_scale"
            android:padding="10dp"
            android:src="@drawable/ic_angle_left_solid"
            app:tint="@color/green_primary"
            android:elevation="24dp"
            android:outlineAmbientShadowColor="@color/chat_shadow_color"
            android:outlineSpotShadowColor="@color/chat_shadow_color" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/about_us"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/green_primary"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:layout_gravity="center_vertical" />

        <View
            android:layout_width="34dp"
            android:layout_height="34dp" />

    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Hero Section -->


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_gravity="center">

                <ImageView
                    android:layout_width="290dp"
                    android:layout_height="150dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/haset_logo"
                    tools:src="@drawable/haset_logo" />

            </LinearLayout>

                
            <!-- Content Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                app:cardCornerRadius="6dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/haset_is_a_digital_health_app_designed_t"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:lineSpacingMultiplier="1.4"
                        android:fontFamily="@font/poppins_medium"
                        android:layout_marginBottom="16dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/the_app_connects_patients_with_qualified"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:lineSpacingMultiplier="1.4"
                        android:fontFamily="@font/poppins_medium"
                        android:layout_marginBottom="16dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/our_goal_is_to_improve_healthcare_access"
                        android:textColor="@color/green_primary"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:lineSpacingMultiplier="1.4"
                        android:fontFamily="@font/poppins_medium" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Medical Disclaimer Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="6dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_info"
                            app:tint="#D32F2F" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/medical_disclaimer"
                            android:textColor="#D32F2F"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins_regular" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/the_information_and_services_provided_th"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:lineSpacingMultiplier="1.3"
                        android:fontFamily="@font/poppins_regular" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Legal Links Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="24dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/btnPrivacyPolicy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/privacy_policy"
                    android:textColor="@color/green_primary"
                    android:textSize="12sp"
                    android:padding="8dp"
                    android:fontFamily="@font/poppins_medium"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="14dp"
                    android:background="@color/text_secondary"
                    android:layout_marginHorizontal="12dp" />

                <TextView
                    android:id="@+id/btnTermsOfService"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/terms_of_service"
                    android:textColor="@color/green_primary"
                    android:textSize="12sp"
                    android:padding="8dp"
                    android:fontFamily="@font/poppins_medium"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>