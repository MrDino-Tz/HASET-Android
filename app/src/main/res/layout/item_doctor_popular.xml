<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRoot"
    android:layout_width="150dp"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/divider"
    app:cardBackgroundColor="?attr/colorCardBackground"
    android:stateListAnimator="@animator/press_scale"
    android:foreground="@drawable/ripple_effect_rounded">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Profile Image Container -->
        <FrameLayout
            android:id="@+id/imageContainer"
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerProfile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:shimmer_auto_start="true"
                app:shimmer_base_alpha="0.8"
                app:shimmer_highlight_alpha="1.0">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/shimmer_circle" />

            </com.facebook.shimmer.ShimmerFrameLayout>

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/ivProfileImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/profile_photo"
                />

            <ImageView
                android:id="@+id/ivVerified"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="2dp"
                android:src="@drawable/verified"
                app:tint="@color/green_primary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvInitials"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:background="@drawable/bg_circle_teal"
                android:textColor="@color/badge_teal_text"
                android:textSize="24sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:text="DR" />

            <!-- Demo Badge -->
            <TextView
                android:id="@+id/tvDemoBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="-4dp"
                android:background="@drawable/bg_demo_badge"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="FREE"
                android:textColor="@android:color/white"
                android:textSize="8sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </FrameLayout>

        <!-- Floating Rating Badge -->
<!--        <LinearLayout-->
<!--            android:id="@+id/layoutRating"-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:orientation="horizontal"-->
<!--            android:gravity="center_vertical"-->
<!--            android:background="@drawable/bg_rating_pill_purple"-->
<!--            android:paddingHorizontal="6dp"-->
<!--            android:paddingVertical="3dp"-->
<!--            android:elevation="4dp"-->
<!--            app:layout_constraintBottom_toBottomOf="@+id/imageContainer"-->
<!--            app:layout_constraintEnd_toEndOf="@+id/imageContainer"-->
<!--            android:layout_marginBottom="-4dp"-->
<!--            android:layout_marginEnd="-4dp">-->

<!--            <ImageView-->
<!--                android:layout_width="10dp"-->
<!--                android:layout_height="10dp"-->
<!--                android:src="@drawable/ic_star_filled"-->
<!--                app:tint="@android:color/white"-->
<!--                android:layout_marginEnd="2dp" />-->

<!--            <TextView-->
<!--                android:id="@+id/tvRating"-->
<!--                android:layout_width="wrap_content"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:text="4.9"-->
<!--                android:textColor="@android:color/white"-->
<!--                android:textSize="10sp"-->
<!--                android:textStyle="bold" />-->
<!--        </LinearLayout>-->

        <!-- Doctor Details -->
        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/poppins"
            android:text="Dr. Sarah Smith"
            android:textColor="?attr/colorPrimaryText"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@+id/imageContainer" />

        <TextView
            android:id="@+id/tvSpecialty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/poppins_regular"
            android:text="Cardiologist"
            android:textColor="@color/green_light"
            android:textSize="11sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@+id/tvName" />

        <TextView
            android:id="@+id/tvFee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_fee_pill"
            android:fontFamily="@font/poppins_medium"
            android:text="50,000 TSH"
            android:textColor="@color/green_primary"
            android:textSize="10sp"
            app:layout_constraintTop_toBottomOf="@+id/tvSpecialty"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
