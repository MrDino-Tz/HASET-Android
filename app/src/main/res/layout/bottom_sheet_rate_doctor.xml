<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_background"
    android:padding="24dp">

    <!-- Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bottom_sheet_handle" />

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Rate Doctor"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="@font/poppins_medium"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvDoctorName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dr. John Doe"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:fontFamily="@font/poppins_medium"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- Rating Stars -->
    <LinearLayout
        android:id="@+id/layoutStars"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="24dp">

        <ImageView
            android:id="@+id/ivStar1"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/btn_star_big_off"
            android:padding="8dp"
            android:foreground="@drawable/ripple_effect_circular"
            android:clickable="true"
            android:focusable="true"
            app:tint="@color/text_hint" />

        <ImageView
            android:id="@+id/ivStar2"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:src="@android:drawable/btn_star_big_off"
            android:padding="8dp"
            android:foreground="@drawable/ripple_effect_circular"            android:clickable="true"
            android:focusable="true"
            app:tint="@color/text_hint" />

        <ImageView
            android:id="@+id/ivStar3"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:src="@android:drawable/btn_star_big_off"
            android:padding="8dp"
            android:foreground="@drawable/ripple_effect_circular"            android:clickable="true"
            android:focusable="true"
            app:tint="@color/text_hint" />

        <ImageView
            android:id="@+id/ivStar4"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:src="@android:drawable/btn_star_big_off"
            android:padding="8dp"
            android:foreground="@drawable/ripple_effect_circular"            android:clickable="true"
            android:focusable="true"
            app:tint="@color/text_hint" />

        <ImageView
            android:id="@+id/ivStar5"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:src="@android:drawable/btn_star_big_off"
            android:padding="8dp"
            android:foreground="@drawable/ripple_effect_circular"            android:clickable="true"
            android:focusable="true"
            app:tint="@color/text_hint" />

    </LinearLayout>

    <!-- Rating Text -->
    <TextView
        android:id="@+id/tvRatingText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tap to rate"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:fontFamily="@font/poppins_medium"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- Comment Section -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Write a review (optional)"
        app:boxStrokeColor="@color/green_primary"
        android:layout_marginBottom="24dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etComment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:minLines="2" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:stateListAnimator="@animator/press_scale"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            android:fontFamily="@font/poppins_medium"
            app:backgroundTint="@android:color/transparent"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmit"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:stateListAnimator="@animator/press_scale"
            android:text="Submit"
            android:textColor="@color/white"
            android:fontFamily="@font/poppins_medium"
            app:backgroundTint="@color/green_primary"
            app:cornerRadius="12dp" />

    </LinearLayout>

</LinearLayout>




