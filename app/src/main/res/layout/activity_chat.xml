<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:background="?attr/colorBackground"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Custom Header Layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:elevation="4dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:clipChildren="false"
            android:clipToPadding="false">

                    <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_search_circle"
            android:foreground="@drawable/ripple_effect_rounded"
            android:clickable="true"
            android:focusable="true"
            android:stateListAnimator="@animator/press_scale"
            android:padding="10dp"
            android:src="@drawable/ic_angle_left_solid"
            app:tint="@color/green_primary"
            android:elevation="24dp"
            android:outlineAmbientShadowColor="@color/chat_shadow_color"
            android:outlineSpotShadowColor="@color/chat_shadow_color" />
<!--            app:tint="?attr/colorOnSurface"-->

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="8dp">

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmerChatProfile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:shimmer_auto_start="true"
                    app:shimmer_base_alpha="0.8"
                    app:shimmer_highlight_alpha="1.0">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/shimmer_circle"
                        android:foreground="@drawable/ripple_effect_circular"/>

                </com.facebook.shimmer.ShimmerFrameLayout>

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/ivChatProfile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/profile_photo"
                    android:tint="@color/chat_shadow_color"/>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvChatName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Johnathan Doe"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvOnlineStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Online"
                    android:textColor="@color/green_primary"
                    android:textSize="12sp" />

            </LinearLayout>

            <ImageView
                android:id="@+id/ivVideoCall"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="3dp"
                android:src="@drawable/ic_video_filled"
                android:background="@drawable/bg_search_circle"
                android:foreground="@drawable/ripple_effect_rounded"
                android:stateListAnimator="@animator/press_scale"
                android:padding="10dp"
                android:elevation="24dp"
                app:tint="@color/green_primary"
                android:clickable="true"
                android:focusable="true"
                android:outlineAmbientShadowColor="@color/chat_shadow_color"
                android:outlineSpotShadowColor="@color/chat_shadow_color"/>

            <ImageView
                android:id="@+id/ivMoreOptions"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_more_vert"
                android:background="@drawable/bg_search_circle"
                android:foreground="@drawable/ripple_effect_rounded"
                android:stateListAnimator="@animator/press_scale"
                android:padding="10dp"
                android:elevation="24dp"
                android:clickable="true"
                android:focusable="true"
                app:tint="@color/green_primary"
                android:outlineAmbientShadowColor="@color/chat_shadow_color"
                android:outlineSpotShadowColor="@color/chat_shadow_color"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Search Bar Layout (Initially Hidden) -->
    <LinearLayout
        android:id="@+id/llSearchBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="?attr/colorBackground"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:elevation="4dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/etSearchMessages"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/rounded_edittext_background"
            android:hint="Search messages..."
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="14sp"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant" />

        <ImageView
            android:id="@+id/ivCloseSearch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:src="@drawable/ic_clear"
            app:tint="?attr/colorOnSurface"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>



    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
    
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMessages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            android:background="?attr/colorBackground" />

    </RelativeLayout>

    <!-- Typing Indicator -->
    <LinearLayout
        android:id="@+id/llTypingIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvTypingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="is typing..."
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"
            android:fontFamily="@font/poppins_medium" />

        <ProgressBar
            android:id="@+id/pbTyping"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"
            android:indeterminateTint="?attr/colorOnSurfaceVariant"
            style="?android:attr/progressBarStyleSmall" />
    </LinearLayout>

    <!-- Reply Preview Container -->
    <LinearLayout
        android:id="@+id/llReplyContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="36dp"
        android:orientation="horizontal"
        android:background="@drawable/rounded_edittext_background"
        android:layout_marginHorizontal="8dp"
        android:layout_marginBottom="4dp"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <View
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@color/green_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/tvReplyName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/green_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="John Doe" />

            <TextView
                android:id="@+id/tvReplyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="This is a message being replied to..." />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivCancelReply"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_clear"
            app:tint="?attr/colorOnSurfaceVariant"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:background="?attr/colorBackground">

        <!-- Input Capsule -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="50dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:background="@drawable/rounded_edittext_background"
            android:elevation="4dp"
            android:outlineAmbientShadowColor="@color/chat_shadow_color"
            android:outlineSpotShadowColor="@color/chat_shadow_color"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="6dp"
            android:paddingTop="6dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:id="@+id/ivAttach"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginBottom="0dp"
                android:src="@drawable/ic_add"
                android:padding="10dp"
                android:background="@drawable/bg_search_circle"
                android:foreground="@drawable/ripple_effect_rounded"
                android:clickable="true"
                android:focusable="true"
                android:elevation="2dp"
                android:outlineAmbientShadowColor="@color/chat_shadow_color"
                android:outlineSpotShadowColor="@color/chat_shadow_color"
                android:stateListAnimator="@animator/press_scale"
                app:tint="@color/green_primary"
                android:contentDescription="Attach file" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="38dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Type something"
                android:inputType="textMultiLine"
                android:maxLines="6"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:gravity="center_vertical"
                android:fontFamily="@font/poppins_regular"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/ivMic"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="9dp"
                android:contentDescription="Voice Message"
                android:src="@drawable/ic_mic"
                app:tint="@color/green_primary"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_search_circle"
                android:foreground="@drawable/ripple_effect_rounded"
                android:stateListAnimator="@animator/press_scale"/>

        </LinearLayout>

        <ImageView
            android:id="@+id/btnSend"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_gravity="bottom"
            android:src="@drawable/send_124"
            android:padding="12dp"
            app:tint="@color/white"
            android:background="@drawable/bg_send_btn"
            android:elevation="6dp"
            android:outlineAmbientShadowColor="@color/chat_shadow_color"
            android:outlineSpotShadowColor="@color/chat_shadow_color"
            android:contentDescription="Send message"
            android:clickable="true"
            android:focusable="true"
            android:enabled="false"
            android:stateListAnimator="@animator/press_scale"/>

    </LinearLayout>

    </LinearLayout>

