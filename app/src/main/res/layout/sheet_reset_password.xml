<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bottom_sheet_background"
    android:clipChildren="false"
    android:clipToPadding="false">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@color/text_secondary" />

    <TextView
        android:id="@+id/tvSheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/reset_password_title"
        android:textColor="@color/green_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="@font/poppins_medium"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvSheetDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/reset_password_sheet_description"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:fontFamily="@font/poppins_regular"
        android:layout_marginBottom="20dp" />

    <!-- Paste link / code (hidden when opened automatically via deep link) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilPasteLink"
        style="@style/EditTextStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:startIconDrawable="@drawable/ic_email"
        app:startIconTint="@color/green_primary"
        app:hintTextColor="@color/text_secondary"
        app:boxStrokeWidth="0dp"
        app:boxBackgroundColor="@color/background_card"
        app:boxCornerRadiusTopStart="20dp"
        app:boxCornerRadiusTopEnd="20dp"
        app:boxCornerRadiusBottomStart="20dp"
        app:boxCornerRadiusBottomEnd="20dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPasteLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/paste_reset_link_hint"
            android:inputType="textUri"
            android:maxLines="3"
            android:textSize="12sp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:fontFamily="@font/poppins_regular" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tvVerifiedEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/green_primary"
        android:textSize="13sp"
        android:fontFamily="@font/poppins_medium"
        android:visibility="gone"
        android:layout_marginBottom="12dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilNewPassword"
        style="@style/EditTextStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:endIconMode="password_toggle"
        app:hintTextColor="@color/text_secondary"
        app:boxStrokeWidth="0dp"
        app:boxBackgroundColor="@color/background_card"
        app:boxCornerRadiusTopStart="20dp"
        app:boxCornerRadiusTopEnd="20dp"
        app:boxCornerRadiusBottomStart="20dp"
        app:boxCornerRadiusBottomEnd="20dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etNewPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/new_password_hint"
            android:inputType="textPassword"
            android:textSize="14sp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:fontFamily="@font/poppins_regular" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilConfirmPassword"
        style="@style/EditTextStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:endIconMode="password_toggle"
        app:hintTextColor="@color/text_secondary"
        app:boxStrokeWidth="0dp"
        app:boxBackgroundColor="@color/background_card"
        app:boxCornerRadiusTopStart="20dp"
        app:boxCornerRadiusTopEnd="20dp"
        app:boxCornerRadiusBottomStart="20dp"
        app:boxCornerRadiusBottomEnd="20dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/confirm_new_password_hint"
            android:inputType="textPassword"
            android:textSize="14sp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:fontFamily="@font/poppins_regular" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnResetPassword"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:stateListAnimator="@animator/press_scale"
        android:text="@string/btn_reset_password"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="@font/poppins_medium"
        app:cornerRadius="20dp"
        android:backgroundTint="@color/green_primary"
        android:textColor="@color/white_primary"
        android:elevation="24dp"
        android:outlineAmbientShadowColor="@color/chat_shadow_color"
        android:outlineSpotShadowColor="@color/chat_shadow_color" />

    <ProgressBar
        android:id="@+id/progressReset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

</LinearLayout>
