<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingTop="32dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/set_up_twofactor_authentication"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/scan_this_qr_code_with_google_authentica"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/mfaQrCard"
            android:layout_width="264dp"
            android:layout_height="264dp"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:strokeColor="#16000000"
            app:strokeWidth="1dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="18dp">

                <ProgressBar
                    android:id="@+id/mfaQrProgress"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/green_primary" />

                <ImageView
                    android:id="@+id/mfaQrCode"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Authenticator setup QR code"
                    android:scaleType="fitCenter"
                    android:visibility="invisible" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/mfaManualToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/cant_scan_use_a_setup_key"
            android:textAllCaps="false" />

        <LinearLayout
            android:id="@+id/mfaManualContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone"
            android:background="@drawable/rounded_card_background">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/manual_setup_key"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/mfaManualKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:textColor="@color/text_primary"
                android:textIsSelectable="true"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/mfaCopyKey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/copy_setup_key"
                android:textAllCaps="false" />
        </LinearLayout>

        <com.haset.hasetapp.ui.MfaCodeInputView
            android:id="@+id/mfaCodeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp" />

        <Button
            android:id="@+id/mfaConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/confirm_code"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/mfaRecoveryCodes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textIsSelectable="true" />

        <CheckBox
            android:id="@+id/mfaSaved"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/i_saved_my_recovery_codes" />

        <Button
            android:id="@+id/mfaContinue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/continue_btn"
            android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
