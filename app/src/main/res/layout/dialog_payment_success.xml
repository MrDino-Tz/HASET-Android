<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="?attr/colorSurface"
    android:paddingHorizontal="32dp"
    android:paddingVertical="48dp">

    <!-- Header Illustration Icon -->
    <ImageView
        android:id="@+id/imgSuccessState"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:src="@drawable/ic_success1"
        android:adjustViewBounds="true"
        android:contentDescription="@string/content_desc_success_icon"
        android:layout_marginBottom="32dp" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/payment_confirmed_1"
        android:textColor="?attr/colorOnSurface"
        android:textSize="24sp"
        android:gravity="center"
        android:fontFamily="@font/poppins_black"
        android:layout_marginBottom="12dp" />

    <!-- Message -->
    <TextView
        android:id="@+id/tvDialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/the_backend_returned_a_successful_paymen"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="15sp"
        android:gravity="center"
        android:fontFamily="@font/poppins_regular"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="40dp" />

    <!-- Action Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDone"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/continue_btn"
        android:textSize="16sp"
        android:fontFamily="@font/poppins_medium"
        android:textColor="@color/white_primary"
        android:stateListAnimator="@animator/press_scale"
        app:backgroundTint="@color/green_primary"
        app:cornerRadius="14dp" />

</LinearLayout>
