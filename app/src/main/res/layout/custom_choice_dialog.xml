<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_background"
    android:padding="24dp">

    <!-- Icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/ivDialogIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_info"
            android:background="@drawable/circle_background_info"
            android:padding="12dp"
            app:tint="@color/info_color" />

    </LinearLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dialog Title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:fontFamily="@font/poppins_medium"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- Radio Group for choices -->
    <RadioGroup
        android:id="@+id/radioGroupChoices"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:orientation="vertical" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNegative"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:stateListAnimator="@animator/press_scale"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            android:fontFamily="@font/poppins_medium"
            app:backgroundTint="@android:color/transparent"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPositive"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:stateListAnimator="@animator/press_scale"
            android:text="Confirm"
            android:textColor="@color/white"
            app:backgroundTint="@color/green_primary"
            android:fontFamily="@font/poppins_medium"
            app:cornerRadius="8dp" />

    </LinearLayout>

</LinearLayout>
