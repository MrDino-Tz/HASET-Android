<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinator"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Fixed Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:elevation="4dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:background="?attr/colorSurface">

        <!-- Header Layout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_search_circle"
                android:foreground="@drawable/ripple_effect_rounded"                android:clickable="true"
                android:focusable="true"
                android:stateListAnimator="@animator/press_scale"
                android:padding="10dp"
                android:src="@drawable/ic_angle_left_solid"
                app:tint="?attr/colorPrimary"
                android:elevation="24dp"
                android:outlineAmbientShadowColor="@color/chat_shadow_color"
                android:outlineSpotShadowColor="@color/chat_shadow_color" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/notifications"
                android:textColor="@color/green_primary"
                android:textSize="20sp"
                android:fontFamily="@font/poppins_medium"
                android:gravity="center"
                android:layout_gravity="center_vertical" />

            <ImageView
                android:id="@+id/btnClearNotifications"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_search_circle"
                android:foreground="@drawable/ripple_effect_circular"
                android:clickable="true"
                android:focusable="true"
                android:stateListAnimator="@animator/press_scale"
                android:padding="10dp"
                android:src="@drawable/ic_more_vert"
                app:tint="?attr/colorPrimary"
                android:elevation="24dp"
                android:outlineAmbientShadowColor="@color/chat_shadow_color"
                android:outlineSpotShadowColor="@color/chat_shadow_color" />

        </LinearLayout>

        <!-- Tab Layout -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:tabMode="fixed"
            app:tabGravity="fill"
            app:tabIndicatorColor="?attr/colorPrimary"
            app:tabSelectedTextColor="?attr/colorPrimary"
            app:tabTextColor="?attr/colorSecondaryText">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/appointment" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/info" />

        </com.google.android.material.tabs.TabLayout>

    </LinearLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="140dp"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">

            <!-- Appointment Shimmer -->
            <LinearLayout
                android:id="@+id/shimmerAppointment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- Appointment Notifications -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAppointmentNotifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="visible"
                android:clipToPadding="false"
                android:paddingBottom="16dp" />

            <!-- Payment Shimmer -->
            <LinearLayout
                android:id="@+id/shimmerPayment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- Payment Notifications -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPaymentNotifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:clipToPadding="false"
                android:paddingBottom="16dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
