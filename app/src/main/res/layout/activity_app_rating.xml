<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:gravity="center"
    android:background="?attr/colorSurface">

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="@string/app_name"
        android:layout_marginBottom="28dp" />

    <TextView
        android:id="@+id/tvRatingTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/rate_haset_title"
        android:textColor="?attr/colorOnSurface"
        android:textSize="22sp"
        android:textStyle="bold"
        android:fontFamily="@font/poppins_medium"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvRatingMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/rate_haset_message"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="14sp"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:id="@+id/layoutStars"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/ivStar1"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_star_outline"
            android:padding="8dp"
            android:foreground="@drawable/ripple_effect_circular"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/tap_to_rate"
            app:tint="@color/star_gray" />

        <ImageView
            android:id="@+id/ivStar2"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_star_outline"
            android:padding="8dp"
            android:foreground="@drawable/ripple_effect_circular"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/tap_to_rate"
            app:tint="@color/star_gray" />

        <ImageView
            android:id="@+id/ivStar3"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_star_outline"
            android:padding="8dp"
            android:foreground="@drawable/ripple_effect_circular"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/tap_to_rate"
            app:tint="@color/star_gray" />

        <ImageView
            android:id="@+id/ivStar4"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_star_outline"
            android:padding="8dp"
            android:foreground="@drawable/ripple_effect_circular"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/tap_to_rate"
            app:tint="@color/star_gray" />

        <ImageView
            android:id="@+id/ivStar5"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_star_outline"
            android:padding="8dp"
            android:foreground="@drawable/ripple_effect_circular"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/tap_to_rate"
            app:tint="@color/star_gray" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvRatingText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tap_to_rate"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="16sp"
        android:fontFamily="@font/poppins_medium"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRateNow"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:minWidth="180dp"
        android:fontFamily="@font/poppins_medium"
        android:stateListAnimator="@animator/press_scale"
        android:text="@string/rate_on_play_store"
        android:textColor="@color/white_primary"
        android:textSize="16sp"
        android:paddingHorizontal="32dp"
        app:backgroundTint="@color/green_primary"
        app:cornerRadius="14dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNotNow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="@android:color/transparent"
        android:fontFamily="@font/poppins_medium"
        android:stateListAnimator="@animator/press_scale"
        android:text="@string/maybe_later"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="14sp"
        style="@style/Widget.Material3.Button.TextButton" />

</LinearLayout>