<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_background"
    android:padding="24dp">

    <!-- Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bottom_sheet_handle" />

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Choose Provider"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="@font/poppins_medium"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sent to `provider` in the payment request"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- Mobile Money Providers -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="2"
        android:alignmentMode="alignMargins"
        android:columnOrderPreserved="false"
        android:padding="4dp">

        <!-- Mpesa -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/llMpesa"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="8dp"
            app:cardElevation="0dp"
            app:cardCornerRadius="12dp"
            android:clickable="true"
            android:focusable="true"
            app:strokeColor="@color/green_primary"
            app:strokeWidth="1.5dp"
            app:cardBackgroundColor="@color/green_light_very">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_centerInParent="true">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/a_m_pesa_logo" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Mpesa"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_medium" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivMpesaSelected"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true"
                    android:src="@drawable/ic_check"
                    app:tint="@color/green_primary"
                    android:visibility="gone" />
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Mixx By Yas -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/llMixxByYas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="8dp"
            app:cardElevation="0dp"
            app:cardCornerRadius="12dp"
            android:clickable="true"
            android:focusable="true"
            app:strokeColor="@color/green_primary"
            app:strokeWidth="1.5dp"
            app:cardBackgroundColor="@color/green_light_very">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_centerInParent="true">

                    <ImageView
                        android:layout_width="90dp"
                        android:layout_height="50dp"
                        android:src="@drawable/a_mixx_by_yas" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Mixx By Yas"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_medium" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivMixxSelected"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true"
                    android:src="@drawable/ic_check"
                    app:tint="@color/green_primary"
                    android:visibility="gone" />
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Halopesa -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/llHalopesa"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="8dp"
            app:cardElevation="0dp"
            app:cardCornerRadius="12dp"
            android:clickable="true"
            android:focusable="true"
            app:strokeColor="@color/green_primary"
            app:strokeWidth="1.5dp"
            app:cardBackgroundColor="@color/green_light_very">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_centerInParent="true">

                    <ImageView
                        android:layout_width="88dp"
                        android:layout_height="50dp"
                        android:src="@drawable/a_halopesa_1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Halopesa"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_medium" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivHalopesaSelected"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true"
                    android:src="@drawable/ic_check"
                    app:tint="@color/green_primary"
                    android:visibility="gone" />
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Airtel Money -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/llAirtelMoney"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="8dp"
            app:cardElevation="0dp"
            app:cardCornerRadius="12dp"
            android:clickable="true"
            android:focusable="true"
            app:strokeColor="@color/green_primary"
            app:strokeWidth="1.5dp"
            app:cardBackgroundColor="@color/green_light_very">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_centerInParent="true">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/a_airtel_money" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Airtel Money"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_medium" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivAirtelMoneySelected"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true"
                    android:src="@drawable/ic_check"
                    app:tint="@color/green_primary"
                    android:visibility="gone" />
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- T-Pesa -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/llTPesa"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="8dp"
            app:cardElevation="0dp"
            app:cardCornerRadius="12dp"
            android:clickable="true"
            android:focusable="true"
            app:strokeColor="@color/green_primary"
            app:strokeWidth="1.5dp"
            app:cardBackgroundColor="@color/green_light_very">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_centerInParent="true">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/a_ttcl_pesa" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="T-Pesa"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_medium" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivTPesaSelected"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true"
                    android:src="@drawable/ic_check"
                    app:tint="@color/green_primary"
                    android:visibility="gone" />
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

    </GridLayout>

</LinearLayout>
