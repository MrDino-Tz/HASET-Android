<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:background="@drawable/ripple_effect_rounded">

    <FrameLayout
        android:id="@+id/layoutCommentProfile"
        android:layout_width="32dp"
        android:layout_height="32dp">

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerCommentProfile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:shimmer_auto_start="true"
            app:shimmer_base_alpha="0.8"
            app:shimmer_highlight_alpha="1.0">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/shimmer_circle" />

        </com.facebook.shimmer.ShimmerFrameLayout>

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/ivCommentProfile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/profile_photo" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="8dp">

        <TextView
            android:id="@+id/tvCommentAuthor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Comment Author"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCommentContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="This is a sample comment."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvCommentTimestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="5m ago"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

</LinearLayout>



