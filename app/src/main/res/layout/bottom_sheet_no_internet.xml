<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:gravity="center"
    android:background="?attr/colorSurface">

    <ImageView
        android:id="@+id/imgErrorState"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:src="@drawable/no_internet1"
        android:adjustViewBounds="true"
        android:contentDescription="No Internet Connection"
        android:layout_marginBottom="28dp" />

    <TextView
        android:id="@+id/tvErrorTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_internet_title"
        android:textColor="?attr/colorOnSurface"
        android:textSize="22sp"
        android:textStyle="bold"
        android:fontFamily="@font/poppins_medium"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvErrorDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_internet_desc"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="14sp"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="36dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRetry"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:minWidth="180dp"
        android:fontFamily="@font/poppins_medium"
        android:stateListAnimator="@animator/press_scale"
        android:text="@string/retry"
        android:textColor="@color/white_primary"
        android:textSize="16sp"
        android:paddingHorizontal="32dp"
        app:backgroundTint="@color/green_primary"
        app:cornerRadius="14dp" />

</LinearLayout>
