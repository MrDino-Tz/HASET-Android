<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp"
        android:backgroundTint="@android:color/transparent"
        android:stateListAnimator="@null">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:contentInsetStart="0dp"
            app:contentInsetLeft="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_search_circle"
                    android:foreground="@drawable/ripple_effect_rounded"                    android:clickable="true"
                    android:focusable="true"
                    android:stateListAnimator="@animator/press_scale"
                    android:padding="10dp"
                    android:src="@drawable/ic_angle_left_solid"
                    app:tint="@color/green_primary"
                    android:elevation="24dp"
                    android:outlineAmbientShadowColor="@color/chat_shadow_color"
                    android:outlineSpotShadowColor="@color/chat_shadow_color" />

                <TextView
                    android:id="@+id/tvToolbarTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/prescriptions"
                    android:textColor="@color/green_primary"
                    android:textSize="20sp"
                    android:fontFamily="@font/poppins_medium"
                    android:gravity="center"
                    android:layout_gravity="center_vertical" />

                <View
                    android:layout_width="34dp"
                    android:layout_height="34dp" />

                <ImageView
                    android:id="@+id/btnDownload"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_search_circle"
                    android:foreground="@drawable/ripple_effect_circular"
                    android:clickable="true"
                    android:focusable="true"
                    android:stateListAnimator="@animator/press_scale"
                    android:padding="10dp"
                    android:src="@drawable/ic_download"
                    app:tint="@color/green_primary"
                    android:elevation="24dp"
                    android:outlineAmbientShadowColor="@color/chat_shadow_color"
                    android:outlineSpotShadowColor="@color/chat_shadow_color"
                    android:visibility="gone" />

            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
