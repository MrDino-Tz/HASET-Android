<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_background"
    android:padding="24dp">

    <!-- Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bottom_sheet_handle" />

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter Payment Account"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="@font/poppins_medium"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvProviderName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Provider Name"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- Account Number Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Payment Account"
        style="@style/EditTextStyle"
        app:startIconTint="@color/text_secondary"
        app:hintTextColor="@color/text_secondary"
        app:boxStrokeColor="@color/green_primary"
        app:boxStrokeWidth="1dp"
        app:boxCornerRadiusTopStart="20dp"
        app:boxCornerRadiusTopEnd="20dp"
        app:boxCornerRadiusBottomStart="20dp"
        app:boxCornerRadiusBottomEnd="20dp"
        android:layout_marginBottom="24dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAccountNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textNoSuggestions"
            android:digits="0123456789 "
            android:maxLength="24"
            android:textSize="14sp"
            android:fontFamily="@font/poppins_regular"
            android:textColor="@color/text_primary"/>

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:text="Cancel"
            android:stateListAnimator="@animator/press_scale"
            android:textColor="@color/text_secondary"
            android:fontFamily="@font/poppins_medium"
            app:backgroundTint="@android:color/transparent"
            app:strokeColor="@color/green_primary"
            app:strokeWidth="1dp"
            app:cornerRadius="12dp"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirm"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:stateListAnimator="@animator/press_scale"
            android:text="Confirm"
            android:textColor="@color/white_primary"
            android:fontFamily="@font/poppins_medium"
            app:backgroundTint="@color/green_primary"
            app:cornerRadius="12dp" />

    </LinearLayout>

</LinearLayout>
