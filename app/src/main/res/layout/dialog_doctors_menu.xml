<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="160dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/popup_menu_background"
    android:padding="4dp">

    <!-- Sort by Name -->
    <TextView
        android:id="@+id/tvSortName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Name"
        android:textSize="13sp"
        android:textColor="?attr/colorPrimaryText"
        android:fontFamily="@font/poppins_medium"
        android:padding="10dp"
        android:background="@drawable/popup_menu_item_selector"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true" />

    <!-- Sort by Rating -->
    <TextView
        android:id="@+id/tvSortRating"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Rating"
        android:textSize="13sp"
        android:textColor="?attr/colorPrimaryText"
        android:fontFamily="@font/poppins_medium"
        android:padding="10dp"
        android:background="@drawable/popup_menu_item_selector"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true" />

    <!-- Sort by Experience -->
    <TextView
        android:id="@+id/tvSortExperience"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Experience"
        android:textSize="13sp"
        android:textColor="?attr/colorPrimaryText"
        android:fontFamily="@font/poppins_medium"
        android:padding="10dp"
        android:background="@drawable/popup_menu_item_selector"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true" />

    <!-- Refresh -->
    <TextView
        android:id="@+id/tvRefresh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Refresh"
        android:textSize="13sp"
        android:textColor="?attr/colorPrimaryText"
        android:fontFamily="@font/poppins_medium"
        android:padding="10dp"
        android:background="@drawable/popup_menu_item_selector"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true" />

    <!-- Filter by Specialty -->
    <TextView
        android:id="@+id/tvFilterSpecialty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Specialty"
        android:textSize="13sp"
        android:textColor="?attr/colorPrimaryText"
        android:fontFamily="@font/poppins_medium"
        android:padding="10dp"
        android:background="@drawable/popup_menu_item_selector"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
