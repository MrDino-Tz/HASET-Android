{
  "database": {
    "rules": "database.rules.json"
  },
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/health-tips",
        "destination": "/health-tips/index.html"
      }
    ]
  },
  "emulators": {
    "database": {
      "port": 9001
    }
  }
}
